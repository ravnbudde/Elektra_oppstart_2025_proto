[Unit]
Description=Elektra hosted scoreboard
After=network-online.target mosquitto.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=elektra-scoreboard
Group=elektra-scoreboard
WorkingDirectory=/opt/elektra-scoreboard
EnvironmentFile=/etc/elektra-scoreboard.env
ExecStart=/opt/elektra-scoreboard/.venv/bin/gunicorn --workers 1 --bind 0.0.0.0:8080 --access-logfile - wsgi:app
Restart=on-failure
RestartSec=3
StateDirectory=elektra-scoreboard
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/elektra-scoreboard

[Install]
WantedBy=multi-user.target
